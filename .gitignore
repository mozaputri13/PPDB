# Dependencies
node_modules/
*/node_modules/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
!.env.example
!backend/.env.example

# SQLite Database & Data files (Protecting Local Data)
backend/data/*.db
backend/data/*.db-journal
backend/data/*.sqlite
!backend/data/.gitkeep

# Uploaded Private Documents (UU PDP Compliance)
backend/storage/documents/*
!backend/storage/documents/.gitkeep

# Build outputs
dist/
dist-ssr/
frontend/dist/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
